    { "op": "set", "entity": "nation", "ref": "n", "command": "#era", "value": "2" },
    { "op": "add", "entity": "nation", "ref": "n", "command": "#addrecunit", "value": "@rider" },
    { "op": "add", "entity": "nation", "ref": "n", "command": "#startsite", "value": "\"Scratch Keep\"" },
